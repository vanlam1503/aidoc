# Add your Gemini API key in Ask Assistant. It is saved server-side in .data/gemini-key.json.
# Optional; defaults to gemini-3.5-flash-lite. Choose a model enabled for your project.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional request deadline, 10000–180000 milliseconds; default 90000.
GEMINI_TIMEOUT_MS=90000
